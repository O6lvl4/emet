// The gate, as a pure function.
//
// Nothing here opens a socket. It takes the claim and whatever came back from its
// sources and returns a verdict, so the same code decides on a laptop, in CI, and
// inside a Worker that did the fetching with the host's own client.
//
// The order of the checks is the design. A claim with no source is refused before
// anything is fetched, and a claim with nothing checkable is refused before that —
// no request is spent to learn that the answer would have been "cannot tell"
// either way. `needs_fetch` is what lets a caller honour that order: ask it first,
// and skip the network when it says no.
//
// A probe counts as found if it appears on any one of the cited pages. Sources are
// a set, not a ranking: a claim citing two pages and taking one figure from each
// is supported.
//
// Only pages that answered are searched. A citation that 403s leaves the claim
// unreachable rather than unsupported, because the two call for different actions
// — one is a source problem, the other a claim problem.

import self.claim
import self.numeric
import self.probes

// What can be settled about a claim before reading anything. A payload-free
// variant rather than an `Option[Verdict]`: an empty option of a heap type is a
// shape the verified wasm renderer has trouble with, and naming the three states
// costs nothing and reads better than a `none` that means "keep going".
local type Early: Eq = NoSource | NoProbes | MustRead

let NO_PROBES = "照合できる手がかりがない（数値も逐語引用も取れない）"

local fn early(c: claim.Claim, min_digits: Int) -> Early =
  if list.is_empty(c.citations) then NoSource
  else if list.is_empty(probes.decisive(probes.of(c.text, min_digits))) then NoProbes
  else MustRead

fn needs_fetch(c: claim.Claim, min_digits: Int) -> Bool = early(c, min_digits) == MustRead

// The page that accounted for the most probes, so the report names the source a
// reader should open first.
local fn best_source(pages: List[claim.Attempt], ps: List[claim.Probe]) -> String = {
  var best = ""
  var best_hits = 0 - 1
  for pg in pages {
    let hits = list.len(list.filter(ps, (p) => probes.found_on(p, pg)))
    if hits > best_hits then {
      best_hits = hits
      best = pg.url
    } else ()
  }
  best
}

// The share of a claim's probes that were found, in percent so the arithmetic
// stays integral. An empty probe list never reaches here — `early` refuses it.
fn support_pct(found: List[claim.Probe], checked: List[claim.Probe]) -> Int =
  100 * list.len(found) / list.len(checked)

fn verdict_at(c: claim.Claim, attempts: List[claim.Attempt], min_digits: Int, min_support: Int) -> claim.Verdict =
  match early(c, min_digits) {
    NoSource => claim.NoCitation,
    NoProbes => claim.Unverifiable { reason: NO_PROBES },
    MustRead => {
      let checked = probes.of(c.text, min_digits)
      let pages = list.filter(attempts, (a) => claim.ok_page(a))
      match list.is_empty(pages) {
        true => match list.first(attempts) {
          none => claim.Unreachable { url: "", detail: "出典を読んでいない" },
          some(a) => claim.Unreachable { url: a.url, detail: a.error },
        },
        false => {
          let found = list.filter(checked, (p) => list.any(pages, (pg) => probes.found_on(p, pg)))
          let missing = list.filter(checked, (p) => not list.any(pages, (pg) => probes.found_on(p, pg)))
          // Decided on the share of probes found, not on whether any is missing.
          //
          // All-or-nothing was measured and it has no usable operating point: over
          // 91 curated timeline entries it caught 100% of corruptions and refused
          // 78% of the correct claims, and every probe family did it (figure 67%,
          // quote 68%, entity 65%). A binary verdict offers nothing to calibrate —
          // there is no score to move a threshold along. A share does, which is what
          // makes the conformal step possible at all rather than merely next.
          match support_pct(found, checked) >= min_support {
            true => claim.Supported { matched: checked, source: best_source(pages, checked) },
            false => claim.Unsupported { missing: missing, matched: found, checked: checked },
          }
        },
      }
    },
  }

// The strict setting, kept as the default so existing callers are unchanged.
fn verdict(c: claim.Claim, attempts: List[claim.Attempt], min_digits: Int) -> claim.Verdict =
  verdict_at(c, attempts, min_digits, 100)

local fn page(url: String, text: String) -> claim.Attempt =
  claim.Attempt { url: url, text: text, nums: numeric.numbers_in(text), error: "" }
local fn failed(url: String, why: String) -> claim.Attempt =
  claim.Attempt { url: url, text: "", nums: [], error: why }
local fn c1(text: String, cites: List[String]) -> claim.Claim = claim.Claim { id: "t", text: text, citations: cites }

test "a claim with no source is refused before any fetch" {
  assert_eq(needs_fetch(c1("売上は53.3%増", []), 3), false)
  assert_eq(claim.tag(verdict(c1("売上は53.3%増", []), [], 3)), "no_citation")
}

test "a claim with no probe of any kind is refused before any fetch" {
  assert_eq(needs_fetch(c1("市場は好調だった", ["https://a"]), 3), false)
  assert_eq(claim.tag(verdict(c1("市場は好調だった", ["https://a"]), [], 3)), "unverifiable")
}

test "a prose claim with a quote is now checkable" {
  let c = c1("社長は「過去最高の需要」と述べた", ["https://a"])
  assert(needs_fetch(c, 3))
  assert_eq(claim.tag(verdict(c, [page("https://a", "社長は過去最高の需要と述べた")], 3)), "supported")
}

test "a prose claim whose quote is absent is refused, and says so" {
  let c = c1("社長は「過去最高の需要」と述べた", ["https://a"])
  let v = verdict(c, [page("https://a", "社長は需要は堅調と述べた")], 3)
  assert_eq(claim.tag(v), "unsupported")
  assert(string.contains(claim.repair(v), "逐語でない引用"))
}

test "a right figure on a page about someone else is refused" {
  let c = c1("TSMCの売上は53.3%増", ["https://a"])
  let v = verdict(c, [page("https://a", "samsung revenue rose 53.3 percent")], 3)
  assert_eq(claim.tag(v), "unsupported")
  assert(string.contains(claim.repair(v), "主題の合う出典"))
}

test "a quote absent from the page still refuses even when figures match" {
  let c = c1("「過去最高」と述べ53.3%増", ["https://a"])
  assert_eq(claim.tag(verdict(c, [page("https://a", "rose 53.3%")], 3)), "unsupported")
}

test "every probe present is supported" {
  let c = c1("TSMCの売上は53.3%増", ["https://a"])
  assert_eq(claim.tag(verdict(c, [page("https://a", "tsmc revenue rose 53.3%")], 3)), "supported")
}

test "probes may come from different sources" {
  let c = c1("TSMCの売上は5148.1億で53.3%増", ["https://a", "https://b"])
  let v = verdict(c, [page("https://a", "tsmc 5148.1"), page("https://b", "53.3")], 3)
  assert_eq(claim.tag(v), "supported")
}

test "a source that did not answer is unreachable, not unsupported" {
  let v = verdict(c1("5148.1億", ["https://a"]), [failed("https://a", "HTTP 403")], 3)
  assert_eq(claim.tag(v), "unreachable")
}

test "one reachable source is enough to judge the claim" {
  let v = verdict(c1("5148.1億", ["https://a", "https://b"]),
    [failed("https://a", "HTTP 403"), page("https://b", "5148.1")], 3)
  assert_eq(claim.tag(v), "supported")
}

test "the source with the most probes is the one reported" {
  let pages = [page("https://a", "53.3"), page("https://b", "53.3 and 10.1")]
  assert_eq(best_source(pages, [claim.probe("figure", "53.3"), claim.probe("figure", "10.1")]), "https://b")
}

test "a source that never names the subject is refused, entity being decisive" {
  let c = c1("TSMCの売上は53.3%増", ["https://a"])
  assert_eq(claim.tag(verdict(c, [page("https://a", "revenue rose 53.3%")], 3)), "unsupported")
}

test "a missing figure still refuses, entity or not" {
  let c = c1("TSMCの売上は5148.1億", ["https://a"])
  assert_eq(claim.tag(verdict(c, [page("https://a", "tsmc said something")], 3)), "unsupported")
}
