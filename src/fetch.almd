// Getting the text of a cited page.
//
// Tags come out, and `script` and `style` bodies come out before them: a figure
// inside a tracking snippet or a CSS rule must never be allowed to vouch for a
// claim. What is left is normalised the same way the claim is, so the two sides
// are compared in one shape.
//
// A default user agent gets a 403 from enough publishers that the gate would
// refuse correct claims for a reason that has nothing to do with the claim, so
// one is sent. A non-2xx is reported as unreachable rather than searched, since
// an error page contains numbers of its own.

import http
import self.tokens

let UA = "Mozilla/5.0 (compatible; emet/0.1; +https://github.com/O6lvl4/emet)"

// Pages past this are truncated. A figure below the cut reads as missing, which
// is a refusal rather than a false pass — the safe direction for a gate.
let MAX_CHARS = 1000000

local fn drop_blocks(src: String, open_tag: String, close_tag: String) -> String =
  match string.index_of(string.to_lower(src), open_tag) {
    none => src,
    some(i) => {
      let head = string.slice(src, 0, i)
      let rest = string.drop(src, i)
      match string.index_of(string.to_lower(rest), close_tag) {
        none => head,
        some(j) => head + " " + drop_blocks(string.drop(rest, j + string.len(close_tag)), open_tag, close_tag),
      }
    },
  }

// Everything between `<` and `>` goes, and the tag leaves a space behind so
// that `<td>53</td><td>3</td>` cannot read as the figure "533".
local fn strip_tags(src: String) -> String = {
  var parts: List[String] = []
  var depth = 0
  for c in string.chars(src) {
    if c == "<" then {
      depth = depth + 1
    } else if c == ">" then {
      depth = if depth > 0 then depth - 1 else 0
      list.push(parts, " ")
    } else {
      if depth == 0 then list.push(parts, c) else ()
    }
  }
  string.join(parts, "")
}

fn page_of(html: String) -> String =
  tokens.normalize(strip_tags(drop_blocks(drop_blocks(string.take(html, MAX_CHARS), "<script", "</script>"), "<style", "</style>")))

effect fn page_text(url: String, timeout_ms: Int) -> Result[String, String] = {
  guard string.starts_with(url, "http://") or string.starts_with(url, "https://") else err("http(s) ではない URL")
  let headers = ["User-Agent": UA, "Accept": "text/html,application/xhtml+xml,text/plain,*/*"]
  let resp = http.request_response("GET", url, "", headers)!
  let code = http.status_code(resp)
  guard code >= 200 and code < 300 else err("HTTP " + int.to_string(code))
  ok(page_of(http.body(resp)))
}

test "tags go, and leave a boundary where they were" {
  assert_eq(page_of("<td>53</td><td>3</td>"), " 53  3 ")
}

test "figures inside script and style cannot vouch" {
  assert_eq(string.contains(page_of("<script>var x = 53.3</script>ok"), "53.3"), false)
  assert_eq(string.contains(page_of("<style>.a{width:53.3px}</style>ok"), "53.3"), false)
}

test "page text is normalised like the claim" {
  assert_eq(string.contains(page_of("<p>NT$5,148.1 Billion</p>"), "5148.1"), true)
}
