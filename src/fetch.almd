// Reading the cited pages. The only part of the tool that touches the network,
// kept to one file so the rest builds and runs where there is no socket
// (src/worker.almd is that path).
//
// Three things measured against real sources, each of which was refusing correct
// claims for reasons that had nothing to do with the claim:
//
//   * A default user agent gets a 403 from enough publishers that one has to be
//     sent.
//   * Newsrooms redirect. `news.samsung.com`, `ir.amd.com`, `www.intc.com` and
//     `news.skhynix.com` all answered 302 to a canonical URL, and every one of
//     those claims came back "unreachable" until the hop was followed.
//   * The read timeout is a process-wide env knob, not a call argument, so the
//     `--timeout-ms` flag has to be written into the environment or it does
//     nothing at all.
//
// A non-2xx that is not a redirect is reported rather than searched, since an
// error page carries figures of its own.

import env
import http
import self.claim
import self.numeric
import self.page

let UA = "Mozilla/5.0 (compatible; emet/0.1; +https://github.com/O6lvl4/emet)"

let MAX_HOPS = 5

// `request_response` here, not the `status` pair: following a redirect needs the
// `Location` header, and only this family carries headers. It has no wasm host
// binding, which costs nothing — this file is native by construction.
local effect fn hop(url: String) -> Result[HttpResponse, String] = {
  let headers = ["User-Agent": UA, "Accept": "text/html,application/xhtml+xml,text/plain,*/*"]
  http.request_response("GET", url, "", headers)
}

// Relative targets are resolved against the host only, which covers every
// redirect seen in practice (`/news/x` from a newsroom root). A relative hop with
// a path-relative target is left alone and reported rather than guessed at.
local fn resolve(from: String, target: String) -> String =
  if string.starts_with(target, "http://") or string.starts_with(target, "https://") then target
  else if string.starts_with(target, "//") then "https:" + target
  else if string.starts_with(target, "/") then {
    let after = string.drop(from, string.len("https://"))
    match string.index_of(after, "/") {
      none => from + target,
      some(i) => string.take(from, string.len("https://") + i) + target,
    }
  } else from

local effect fn follow(url: String, hops_left: Int) -> Result[String, String] = {
  guard hops_left > 0 else err("リダイレクトが多すぎる")
  let resp = hop(url)!
  let code = http.status_code(resp)
  if code >= 200 and code < 300 then ok(page.text_of(http.body(resp)))
  else if code >= 300 and code < 400 then match http.get_header(resp, "Location") {
    none => err("HTTP " + int.to_string(code) + " (Location がない)"),
    some(target) => follow(resolve(url, target), hops_left - 1)!,
  }
  else err("HTTP " + int.to_string(code))
}

effect fn page_text(url: String) -> Result[String, String] = {
  guard string.starts_with(url, "http://") or string.starts_with(url, "https://") else err("http(s) ではない URL")
  follow(url, MAX_HOPS)
}

// The read timeout is process-wide. Set once, before anything is fetched.
effect fn set_timeout(timeout_ms: Int) -> Unit =
  env.set("ALMIDE_HTTP_TIMEOUT_SECS", int.to_string(if timeout_ms < 1000 then 1 else timeout_ms / 1000))

// Read every source a claim cites. A failure is a value, not a stop: one 403
// among three citations still leaves the claim judgeable on the other two.
effect fn attempts(c: claim.Claim) -> List[claim.Attempt] = {
  var out: List[claim.Attempt] = []
  for url in c.citations {
    match page_text(url) {
      ok(text) => list.push(out, claim.Attempt { url: url, text: text, nums: numeric.numbers_in(text), error: "" }),
      err(why) => list.push(out, claim.Attempt { url: url, text: "", nums: [], error: why }),
    }
  }
  out
}

test "absolute redirect targets are taken as they are" {
  assert_eq(resolve("https://ir.amd.com/news/x", "https://ir.amd.com/news/y"), "https://ir.amd.com/news/y")
}

test "root-relative targets resolve against the host" {
  assert_eq(resolve("https://news.samsung.com/global/old", "/global/new"), "https://news.samsung.com/global/new")
}

test "protocol-relative targets keep https" {
  assert_eq(resolve("https://a.example/x", "//b.example/y"), "https://b.example/y")
}
